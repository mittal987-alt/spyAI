# ===================================================================
# ModelAutopsy AI - Environment Configuration Template
# Copy this file to .env and customize for your deployment environment.
# ===================================================================

# Environment mode: 'development' or 'production'
MODELAUTOPSY_ENV=development

# Optional API key for sensitive mutating endpoints (e.g. creating/deleting webhooks, clearing alerts)
# When left empty, API endpoints are open for local development workflows.
MODELAUTOPSY_API_KEY=

# Allowed CORS origins (comma-separated). Prohibited from using '*' with credentials in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Allowed host headers (comma-separated) for TrustedHostMiddleware
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Webhook Outbound SSRF Protection
# Set to 'true' only in local/isolated test environments to allow loopback (127.0.0.1) destinations.
# In production, must be 'false'.
MODELAUTOPSY_WEBHOOK_ALLOW_LOCAL=false

# File Upload Limits
# Maximum CSV upload size in bytes (default: 10485760 = 10 MB)
MODELAUTOPSY_MAX_UPLOAD_BYTES=10485760

# Maximum rows and columns for CSV dataset processing
MODELAUTOPSY_MAX_ROWS=50000
MODELAUTOPSY_MAX_COLUMNS=200

# Custom Storage Directories (optional)
# MODELAUTOPSY_ARTIFACTS_DIR=C:\projects\spyai\artifacts
# MODELAUTOPSY_REPORTS_DIR=C:\projects\spyai\reports
